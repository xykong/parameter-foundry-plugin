<?jelly escape-by-default='true'?>
<j:jelly xmlns:j="jelly:core" xmlns:f="/lib/form">
  <f:entry title="Name" field="name"><f:textbox /></f:entry>
  <f:entry title="Type" field="type">
    <f:select />
  </f:entry>
  <f:entry title="Label" field="label"><f:textbox /></f:entry>
  <f:entry title="Description" field="description"><f:textarea /></f:entry>
  <f:entry title="Required" field="required"><f:checkbox /></f:entry>
  <f:entry title="Secret" field="secret"
           description="Secret fields cannot be exported through the complete-form environment variable.">
    <f:checkbox />
  </f:entry>
  <f:entry title="Default value" field="defaultValue"
           description="Objects and arrays use JSON. Other types use their canonical text form.">
    <f:textbox />
  </f:entry>
  <f:entry title="Minimum length" field="minLength"><f:number min="-1" /></f:entry>
  <f:entry title="Maximum length" field="maxLength"><f:number min="-1" /></f:entry>
  <f:entry title="Regex" field="pattern"><f:textbox /></f:entry>
  <f:entry title="Minimum number" field="minimum"><f:number /></f:entry>
  <f:entry title="Maximum number" field="maximum"><f:number /></f:entry>
  <f:entry title="Minimum items" field="minItems"><f:number min="0" /></f:entry>
  <f:entry title="Maximum items" field="maxItems"><f:number min="-1" /></f:entry>
  <f:entry title="Array item type" field="itemType"><f:textbox /></f:entry>
  <f:entry title="Choices" field="choices">
    <f:repeatableProperty field="choices" add="Add choice" header="Choice" />
  </f:entry>
  <f:entry title="Nested fields">
    <div class="jenkins-alert jenkins-alert-info">
      Configure nested object and object-array fields through Pipeline, Job DSL, or JCasC.
      The browser editor intentionally avoids an unbounded recursive form.
    </div>
  </f:entry>
  <f:entry title="Environment variable" field="environmentVariable">
    <f:textbox />
  </f:entry>
  <f:entry title=""><div align="right"><f:repeatableDeleteButton /></div></f:entry>
</j:jelly>
