<?jelly escape-by-default='true'?>
<j:jelly xmlns:j="jelly:core" xmlns:f="/lib/form">
  <f:section title="Parameter Foundry feature switches">
    <f:entry title="Enable retired File Parameters history reader" field="legacyFileHistoryEnabled"
             description="Completed local values and passive graph metadata only; full restart required.">
      <f:checkbox />
    </f:entry>
    <f:entry title="Historical file read limit in bytes" field="legacyFileHistoryMaxBytes"
             description="Independent history limit; default 100 MiB. Changes require full restart.">
      <f:number min="1" />
    </f:entry>
    <f:entry title="Enable retired Git parameter history reader" field="legacyGitHistoryEnabled"
             description="Explicit retirement mode; changes require a complete Jenkins restart.">
      <f:checkbox />
    </f:entry>
    <f:entry title="Enable retired Extended Choice history reader" field="legacyExtendedChoiceHistoryEnabled"
             description="Post-definition-migration string history only; complete restart required.">
      <f:checkbox />
    </f:entry>
    <f:entry title="Enable migration adapters" field="migrationAdaptersEnabled"
             description="Expose source-plugin migration previews and apply/clone actions.">
      <f:checkbox />
    </f:entry>
    <f:entry title="Enable sandboxed Script Provider" field="scriptProviderEnabled"
             description="Allow governed catalog references to use the built-in sandboxed Groovy engine.">
      <f:checkbox />
    </f:entry>
    <f:entry title="Enable Git refs Provider" field="gitRefsProviderEnabled"
             description="Allow branch, tag, and full-ref discovery through governed Connection Profiles.">
      <f:checkbox />
    </f:entry>
    <f:entry title="Enable accessible choice-grid Renderer" field="accessibleChoiceGridEnabled"
             description="Expose the packaged accessible choice-grid renderer.">
      <f:checkbox />
    </f:entry>
  </f:section>
  <f:section title="Parameter Foundry shared providers">
    <f:entry title="Global Providers" field="providers">
      <f:repeatableHeteroProperty field="providers"
                                  hasHeader="true"
                                  addCaption="Add Provider" />
    </f:entry>
    <f:entry title="Global Connection Profiles" field="connectionProfiles">
      <f:repeatableProperty field="connectionProfiles"
                            add="Add Connection Profile"
                            header="Connection Profile" />
    </f:entry>
  </f:section>
</j:jelly>
