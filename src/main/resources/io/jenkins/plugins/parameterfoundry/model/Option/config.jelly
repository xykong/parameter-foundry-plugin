<?jelly escape-by-default='true'?>
<j:jelly xmlns:j="jelly:core" xmlns:f="/lib/form">
  <f:entry title="Machine value" field="value">
    <f:textbox />
  </f:entry>
  <f:entry title="Label" field="label">
    <f:textbox />
  </f:entry>
  <f:entry title="Description" field="description">
    <f:textbox />
  </f:entry>
  <f:entry title="Group" field="group">
    <f:textbox />
  </f:entry>
  <f:entry title="Tags" field="tagsText">
    <f:textbox />
  </f:entry>
  <f:entry title="Disabled" field="disabled">
    <f:checkbox />
  </f:entry>
  <f:entry title="Disabled reason" field="disabledReason">
    <f:textbox />
  </f:entry>
</j:jelly>
