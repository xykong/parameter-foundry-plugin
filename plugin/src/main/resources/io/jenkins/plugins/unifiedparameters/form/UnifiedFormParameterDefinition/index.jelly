<?jelly escape-by-default='true'?>
<j:jelly xmlns:j="jelly:core" xmlns:f="/lib/form" xmlns:st="jelly:stapler">
  <st:adjunct includes="io.jenkins.plugins.unifiedparameters.form-ui"/>
  <j:forEach var="adjunct" items="${it.rendererAdjuncts}">
    <st:adjunct includes="${adjunct}"/>
  </j:forEach>
  <j:set var="escapeEntryTitleAndDescription" value="false"/>
  <f:entry title="${h.escape(it.name)}" description="${it.formattedDescription}">
    <div name="parameter" class="up-form" data-up-form="true"
         data-parameter-name="${it.name}" data-renderer="${it.renderer}"
         data-up-schema-load-error="${it.uiSchemaLoadError}"
         data-up-value-synchronized="${it.uiValueSynchronized}"
         data-up-nested-json-invalid="${it.uiNestedJsonInvalid}">
      <input type="hidden" name="name" value="${it.name}" />
      <textarea data-up-form-schema="true" hidden="hidden">${it.schemaJson}</textarea>
      <div data-up-form-fallback="true">
        <label>
          <span>JSON object</span>
          <textarea class="jenkins-input" name="value" rows="8">${it.defaultJson}</textarea>
        </label>
      </div>
      <div data-up-form-enhanced="true"></div>
      <div class="up-form-status" role="status" aria-live="polite"></div>
    </div>
  </f:entry>
</j:jelly>
