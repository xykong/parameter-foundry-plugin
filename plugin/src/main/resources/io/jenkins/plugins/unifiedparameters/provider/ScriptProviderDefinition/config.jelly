<?jelly escape-by-default='true'?>
<j:jelly xmlns:j="jelly:core" xmlns:f="/lib/form">
  <f:entry title="Provider ID" field="id"><f:textbox /></f:entry>
  <f:entry title="Display name" field="displayName"><f:textbox /></f:entry>
  <f:entry title="Reviewed engine ID" field="engineId"
           description="This references an installed companion engine; core does not execute source text.">
    <f:textbox />
  </f:entry>
  <f:entry title="Governed source reference" field="sourceReference"
           description="Use a reviewed repository/catalog reference, never inline script source.">
    <f:textbox />
  </f:entry>
  <f:entry title="Available to nested Folders" field="usableByChildren"><f:checkbox /></f:entry>
  <f:entry title="Transforms" field="transforms">
    <f:repeatableProperty field="transforms" add="Add transform" header="Transform" />
  </f:entry>
  <f:entry title="Cache TTL seconds" field="cacheTtlSeconds"><f:number min="0" max="86400" /></f:entry>
  <f:entry title="Timeout seconds" field="timeoutSeconds"><f:number min="1" max="30" /></f:entry>
  <f:entry title="Failure policy" field="failurePolicy">
    <select name="_.failurePolicy" class="jenkins-select__input select">
      <option value="fail-closed" selected="${it.failurePolicy == 'fail-closed' ? 'selected' : null}">Fail closed</option>
      <option value="last-known-good" selected="${it.failurePolicy == 'last-known-good' ? 'selected' : null}">Last known good</option>
      <option value="empty" selected="${it.failurePolicy == 'empty' ? 'selected' : null}">Empty result</option>
    </select>
  </f:entry>
  <f:entry title="Maximum staleness seconds" field="maximumStalenessSeconds">
    <f:number min="0" max="604800" />
  </f:entry>
</j:jelly>
