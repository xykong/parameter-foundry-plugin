<?jelly escape-by-default='true'?>
<j:jelly xmlns:j="jelly:core" xmlns:f="/lib/form">
  <f:entry title="Provider ID" field="id">
    <f:textbox />
  </f:entry>
  <f:entry title="Display name" field="displayName">
    <f:textbox />
  </f:entry>
  <f:entry title="Managed Config ID" field="configId">
    <f:textbox />
  </f:entry>
  <f:entry title="Format" field="format">
    <select name="_.format" class="jenkins-select__input select">
      <option value="auto" selected="${it.format == 'auto' ? 'selected' : null}">Auto detect</option>
      <option value="yaml" selected="${it.format == 'yaml' ? 'selected' : null}">YAML</option>
      <option value="json" selected="${it.format == 'json' ? 'selected' : null}">JSON</option>
      <option value="xml" selected="${it.format == 'xml' ? 'selected' : null}">XML</option>
    </select>
  </f:entry>
  <f:entry title="Root JSONPath/XPath" field="rootPath">
    <f:textbox />
  </f:entry>
  <f:entry title="Value path" field="valuePath">
    <f:textbox />
  </f:entry>
  <f:entry title="Label path" field="labelPath">
    <f:textbox />
  </f:entry>
  <f:entry title="Description path" field="descriptionPath">
    <f:textbox />
  </f:entry>
  <f:entry title="Group path" field="groupPath">
    <f:textbox />
  </f:entry>
  <f:entry title="Disabled path" field="disabledPath">
    <f:textbox />
  </f:entry>
  <f:entry title="Disabled reason path" field="disabledReasonPath">
    <f:textbox />
  </f:entry>
  <f:entry title="Tags path" field="tagsPath">
    <f:textbox />
  </f:entry>
  <f:entry title="Available to nested Folders" field="usableByChildren">
    <f:checkbox />
  </f:entry>
  <f:entry title="Transforms" field="transforms">
    <f:repeatableProperty field="transforms" add="Add transform" header="Transform" />
  </f:entry>
  <f:entry title="Cache TTL seconds" field="cacheTtlSeconds">
    <f:number min="0" max="86400" />
  </f:entry>
  <f:entry title="Failure policy" field="failurePolicy">
    <select name="_.failurePolicy" class="jenkins-select__input select">
      <option value="fail-closed" selected="${it.failurePolicy == 'fail-closed' ? 'selected' : null}">Fail closed</option>
      <option value="last-known-good" selected="${it.failurePolicy == 'last-known-good' ? 'selected' : null}">Last known good</option>
      <option value="empty" selected="${it.failurePolicy == 'empty' ? 'selected' : null}">Empty result</option>
    </select>
  </f:entry>
</j:jelly>
