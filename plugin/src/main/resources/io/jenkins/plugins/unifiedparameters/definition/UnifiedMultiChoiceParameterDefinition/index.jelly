<?jelly escape-by-default='true'?>
<j:jelly xmlns:j="jelly:core" xmlns:f="/lib/form" xmlns:st="jelly:stapler">
  <st:adjunct includes="io.jenkins.plugins.unifiedparameters.ui"/>
  <j:forEach var="adjunct" items="${it.rendererAdjuncts}">
    <st:adjunct includes="${adjunct}"/>
  </j:forEach>
  <j:set var="escapeEntryTitleAndDescription" value="false"/>
  <f:entry class="unified-parameters-entry" title="${h.escape(it.name)}" description="${it.formattedDescription}">
    <div name="parameter" class="unified-parameters-field" data-unified-parameter="true"
         data-parameter-name="${it.name}" data-renderer="${it.renderer}"
         data-selected-display="${it.selectedDisplay}"
         data-table="${it.tableJson}"
         data-multiple="true" data-required="${it.required}" data-option-count="${it.optionCount}"
         data-provider-backed="${it.providerBacked}" data-depends-on="${it.dependsOnText}"
         data-up-search-placeholder="${it.uiSearchPlaceholder}"
         data-up-search-label="${it.uiSearchLabel}"
         data-up-selected-options-label="${it.uiSelectedOptionsLabel}"
         data-up-available-options-label="${it.uiAvailableOptionsLabel}"
         data-up-limited-matches="${it.uiLimitedMatches}"
         data-up-selection-summary="${it.uiSelectionSummaryTemplate}"
         data-up-selection-updated="${it.uiSelectionUpdated}"
         data-up-select-group="${it.uiSelectGroup}"
         data-up-group-selection-updated="${it.uiGroupSelectionUpdated}"
         data-up-selection-changed="${it.uiSelectionChanged}"
         data-up-removed="${it.uiRemovedTemplate}"
         data-up-no-options-match="${it.uiNoOptionsMatch}"
         data-up-select-visible="${it.uiSelectVisible}"
         data-up-invert-visible="${it.uiInvertVisible}"
         data-up-clear-visible="${it.uiClearVisible}"
         data-up-clear-all="${it.uiClearAll}"
         data-up-visible-selection-updated="${it.uiVisibleSelectionUpdated}"
         data-up-visible-selection-inverted="${it.uiVisibleSelectionInverted}"
         data-up-visible-selection-cleared="${it.uiVisibleSelectionCleared}"
         data-up-all-selections-cleared="${it.uiAllSelectionsCleared}"
         data-up-custom-value-selected="${it.uiCustomValueSelected}"
         data-up-custom-value-invalid-with-rule="${it.uiCustomValueInvalidWithRule}"
         data-up-custom-value-policy="${it.uiCustomValuePolicy}">
      <input type="hidden" name="name" value="${it.name}" />
      <input type="hidden" name="__unified_parameters_presence" value="${it.name}" />
      <input type="hidden" name="__up_snapshot_${it.name}" data-up-snapshot-id="true" value="" />
      <input type="hidden" name="__up_dependencies_${it.name}" data-up-dependencies-json="true" value="{}" />
      <div data-up-fallback="true">
        <j:if test="${it.providerBacked}">
          <div class="unified-parameters-fallback-warning">
            This parameter uses shared Provider ${it.providerId}. JavaScript or the
            Typed API is required to resolve its governed option set.
          </div>
        </j:if>
        <j:choose>
          <j:when test="${it.providerBacked}">
            <div class="unified-parameters-status" data-up-refresh-status="true"
                 role="status" aria-live="polite">
              Loading options...
            </div>
          </j:when>
          <j:otherwise>
            <j:forEach var="defaultValue" items="${it.defaultParameterValue.value}">
              <input type="hidden" name="value" data-up-fallback-json-value="true"
                     value="${defaultValue}" />
            </j:forEach>
            <j:if test="${it.fallbackTruncated}">
              <div class="unified-parameters-fallback-warning">
                This parameter has ${it.optionCount} options. Without JavaScript, the first
                ${it.NO_JAVASCRIPT_OPTION_LIMIT} options are available. Use search or the Typed API
                to access the complete set.
              </div>
            </j:if>
            <j:choose>
              <j:when test="${it.renderer == 'list'}">
                <div class="jenkins-select">
                  <select class="jenkins-select__input" name="${it.name}"
                          data-up-native-value="true" multiple="multiple">
                    <j:forEach var="option" items="${it.fallbackChoices}">
                      <option value="${option.value}"
                              selected="${it.isDefault(option.value) ? 'selected' : null}"
                              disabled="${option.disabled ? 'disabled' : null}">${option.label}</option>
                    </j:forEach>
                  </select>
                </div>
              </j:when>
              <j:otherwise>
                <j:forEach var="option" items="${it.fallbackChoices}">
                  <label>
                    <input type="checkbox" name="${it.name}" data-up-native-value="true"
                           value="${option.value}"
                           checked="${it.isDefault(option.value) ? 'checked' : null}"
                           disabled="${option.disabled ? 'disabled' : null}" />
                    <span>${option.label}</span>
                    <j:if test="${option.disabled and option.disabledReason != null}">
                      <span> — ${option.disabledReason}</span>
                    </j:if>
                  </label>
                </j:forEach>
              </j:otherwise>
            </j:choose>
          </j:otherwise>
        </j:choose>
      </div>
      <j:if test="${it.noJavaScriptSubmitOwner}">
        <noscript>
          <div class="up-no-javascript-submit">
            <input type="hidden" name="${h.getCrumbRequestField()}"
                   value="${h.getCrumb(request2)}" />
            <button type="submit" formmethod="post"
                    formaction="buildWithParameters?delay=0sec"
                    class="jenkins-button jenkins-button--primary">
              Build without JavaScript
            </button>
          </div>
        </noscript>
      </j:if>
    </div>
  </f:entry>
</j:jelly>
