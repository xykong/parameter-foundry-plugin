<?jelly escape-by-default='true'?>
<j:jelly xmlns:j="jelly:core" xmlns:f="/lib/form" xmlns:st="jelly:stapler">
  <st:adjunct includes="io.jenkins.plugins.unifiedparameters.config-import"/>
  <div class="up-parameter-config">
  <j:if test="${!empty instance.configurationWarnings}">
    <div class="jenkins-alert jenkins-alert-warning" role="status">
      <strong>Configuration warning</strong>
      <j:forEach var="warning" items="${instance.configurationWarnings}">
        <p>${warning}</p>
      </j:forEach>
    </div>
  </j:if>
  <f:entry title="Name" help="/help/parameter/name.html">
    <f:textbox name="parameter.name" value="${instance.name}" />
  </f:entry>
  <f:entry title="Shared Provider ID"
           description="Leave empty to use the Inline choices below.">
    <f:textbox name="parameter.providerId" value="${instance.providerId}" />
  </f:entry>
  <f:entry title="Depends on"
           description="Comma- or line-separated parameter names. Reactive dependencies require a shared Provider.">
    <f:textarea name="parameter.dependsOnText" value="${instance.dependsOnText}" />
  </f:entry>
  <f:entry title="Choices" field="choices">
    <div class="up-option-editor">
      <f:repeatableProperty field="choices" add="Add option" header="Option" />
    </div>
  </f:entry>
  <f:entry title="Import YAML or JSON">
    <div class="up-import-panel" data-up-import-panel="true" data-parameter-kind="multiple"
         data-endpoint="${rootURL}/descriptorByName/io.jenkins.plugins.unifiedparameters.definition.UnifiedMultiChoiceParameterDefinition/previewImport">
      <f:textarea class="up-import-source" />
      <div class="up-import-actions">
        <button type="button" class="jenkins-button" data-up-import-preview-button="true">Preview import</button>
        <button type="button" class="jenkins-button" data-up-import-apply-button="true" disabled="disabled">Apply import</button>
      </div>
      <div class="up-import-preview">
        <p class="up-import-status" data-up-import-status="true" role="status" aria-live="polite">
          Paste YAML or JSON, then preview it before changing the option editor.
        </p>
        <div data-up-import-rows="true"></div>
        <pre class="up-import-generated" data-up-import-generated="true"></pre>
      </div>
    </div>
  </f:entry>
  <f:entry title="Renderer">
    <select class="jenkins-select__input" name="parameter.renderer">
      <option value="checkbox" selected="${instance.renderer == 'checkbox' ? 'selected' : null}">Checkbox group</option>
      <option value="list" selected="${instance.renderer == 'list' ? 'selected' : null}">Multi-select list</option>
      <j:forEach var="rendererId" items="${instance.availableExternalRenderers}">
        <option value="${rendererId}" selected="${instance.renderer == rendererId ? 'selected' : null}">${rendererId}</option>
      </j:forEach>
    </select>
  </f:entry>
  <f:entry title="Selected value display">
    <select class="jenkins-select__input" name="parameter.selectedDisplay">
      <option value="none" selected="${instance.selectedDisplay == 'none' ? 'selected' : null}">Hidden</option>
      <option value="chips" selected="${instance.selectedDisplay == 'chips' ? 'selected' : null}">Chips</option>
    </select>
  </f:entry>
  <f:entry title="Default mode">
    <select class="jenkins-select__input" name="parameter.defaultMode">
      <option value="none" selected="${instance.defaultMode == 'none' ? 'selected' : null}">None</option>
      <option value="first" selected="${instance.defaultMode == 'first' ? 'selected' : null}">First enabled option</option>
      <option value="explicit" selected="${instance.defaultMode == 'explicit' ? 'selected' : null}">Explicit values</option>
    </select>
  </f:entry>
  <f:entry title="Default values">
    <f:textarea name="parameter.defaultValuesText" value="${instance.defaultValuesText}" />
  </f:entry>
  <f:entry title="Minimum selections">
    <f:number name="parameter.minSelections" value="${instance.minSelections}" min="0" />
  </f:entry>
  <f:entry title="Maximum selections">
    <f:number name="parameter.maxSelections" value="${instance.maxSelections}" min="-1" />
  </f:entry>
  <f:entry title="Required">
    <f:checkbox name="parameter.required" checked="${instance.required}" />
  </f:entry>
  <f:entry title="Standard API input mode">
    <select class="jenkins-select__input" name="parameter.standardApiInputMode">
      <option value="repeated" selected="${instance.standardApiInputMode == 'repeated' ? 'selected' : null}">Repeated fields</option>
      <option value="json-array" selected="${instance.standardApiInputMode == 'json-array' ? 'selected' : null}">JSON array field</option>
      <option value="delimited" selected="${instance.standardApiInputMode == 'delimited' ? 'selected' : null}">Delimited field</option>
    </select>
  </f:entry>
  <f:entry title="Delimiter">
    <f:textbox name="parameter.delimiter" value="${instance.delimiter}" />
  </f:entry>
  <f:entry title="Description" help="/help/parameter/description.html">
    <f:textarea name="parameter.description" value="${instance.description}" />
  </f:entry>
  </div>
</j:jelly>
