<?jelly escape-by-default='true'?>
<j:jelly xmlns:j="jelly:core" xmlns:f="/lib/form">
  <f:entry title="Catalog ID" field="id">
    <f:textbox />
  </f:entry>
  <f:entry title="Sandboxed Groovy" field="script">
    <f:property field="script" propertyDescriptor="${descriptor.scriptDescriptor}" />
  </f:entry>
</j:jelly>
