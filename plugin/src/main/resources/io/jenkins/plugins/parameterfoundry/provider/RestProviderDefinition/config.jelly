<?jelly escape-by-default='true'?>
<j:jelly xmlns:j="jelly:core" xmlns:f="/lib/form">
  <f:entry title="Provider ID" field="id">
    <f:textbox />
  </f:entry>
  <f:entry title="Display name" field="displayName">
    <f:textbox />
  </f:entry>
  <f:entry title="Connection Profile ID" field="connectionProfileId">
    <f:textbox />
  </f:entry>
  <f:entry title="Relative path" field="relativePath">
    <f:textbox />
  </f:entry>
  <f:entry title="Query parameters" field="queryParameters">
    <f:repeatableProperty field="queryParameters"
                          add="Add query parameter"
                          header="Query parameter" />
  </f:entry>
  <f:entry title="Format" field="format">
    <select name="_.format" class="jenkins-select__input select">
      <option value="auto" selected="${instance.format == 'auto' ? 'selected' : null}">From Content-Type</option>
      <option value="json" selected="${instance.format == 'json' ? 'selected' : null}">JSON</option>
      <option value="xml" selected="${instance.format == 'xml' ? 'selected' : null}">XML</option>
    </select>
  </f:entry>
  <f:entry title="Response mode" field="responseMode">
    <select name="_.responseMode" class="jenkins-select__input select">
      <option value="mapped" selected="${instance.responseMode == 'mapped' ? 'selected' : null}">Mapped JSON/XML</option>
      <option value="active-choices-choice" selected="${instance.responseMode == 'active-choices-choice' ? 'selected' : null}">Active Choices single JSON</option>
      <option value="active-choices-cascade" selected="${instance.responseMode == 'active-choices-cascade' ? 'selected' : null}">Active Choices reactive single JSON</option>
    </select>
  </f:entry>
  <f:entry title="Root JSONPath/XPath" field="rootPath">
    <f:textbox />
  </f:entry>
  <f:entry title="Value path" field="valuePath">
    <f:textbox />
  </f:entry>
  <f:entry title="Label path" field="labelPath">
    <f:textbox />
  </f:entry>
  <f:entry title="Description path" field="descriptionPath">
    <f:textbox />
  </f:entry>
  <f:entry title="Group path" field="groupPath">
    <f:textbox />
  </f:entry>
  <f:entry title="Disabled path" field="disabledPath">
    <f:textbox />
  </f:entry>
  <f:entry title="Disabled reason path" field="disabledReasonPath">
    <f:textbox />
  </f:entry>
  <f:entry title="Tags path" field="tagsPath">
    <f:textbox />
  </f:entry>
  <f:entry title="Available to nested Folders" field="usableByChildren">
    <f:checkbox />
  </f:entry>
  <f:entry title="Transforms" field="transforms">
    <f:repeatableProperty field="transforms" add="Add transform" header="Transform" />
  </f:entry>
  <f:entry title="Fallback options" field="fallbackOptions">
    <f:repeatableProperty field="fallbackOptions" add="Add fallback option" header="Option" />
  </f:entry>
  <f:entry title="Cache TTL seconds" field="cacheTtlSeconds">
    <f:number min="0" max="86400" />
  </f:entry>
  <f:entry title="Timeout seconds" field="timeoutSeconds">
    <f:number min="1" max="30" />
  </f:entry>
  <f:entry title="Failure policy" field="failurePolicy">
    <select name="_.failurePolicy" class="jenkins-select__input select">
      <option value="fail-closed" selected="${instance.failurePolicy == 'fail-closed' ? 'selected' : null}">Fail closed</option>
      <option value="last-known-good" selected="${instance.failurePolicy == 'last-known-good' ? 'selected' : null}">Last known good</option>
      <option value="empty" selected="${instance.failurePolicy == 'empty' ? 'selected' : null}">Empty result</option>
    </select>
  </f:entry>
  <f:entry title="Maximum staleness seconds" field="maximumStalenessSeconds">
    <f:number min="0" max="604800" />
  </f:entry>
</j:jelly>
