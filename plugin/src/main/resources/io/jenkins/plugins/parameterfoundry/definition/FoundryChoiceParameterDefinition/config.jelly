<?jelly escape-by-default='true'?>
<j:jelly xmlns:j="jelly:core" xmlns:f="/lib/form" xmlns:st="jelly:stapler">
  <st:adjunct includes="io.jenkins.plugins.parameterfoundry.config-import"/>
  <div class="up-parameter-config">
  <j:if test="${!empty instance.configurationWarnings}">
    <div class="jenkins-alert jenkins-alert-warning" role="status">
      <strong>Configuration warning</strong>
      <j:forEach var="warning" items="${instance.configurationWarnings}">
        <p>${warning}</p>
      </j:forEach>
    </div>
  </j:if>
  <f:entry title="Name" help="/help/parameter/name.html">
    <f:textbox name="parameter.name" value="${instance.name}" />
  </f:entry>
  <f:entry title="Selection mode" field="selectionMode"
           description="Single returns a scalar value; multiple returns a deterministic list.">
    <select class="jenkins-select__input" name="parameter.selectionMode">
      <option value="single" selected="${instance.selectionMode == 'single' ? 'selected' : null}">Single</option>
      <option value="multiple" selected="${instance.selectionMode == 'multiple' ? 'selected' : null}">Multiple</option>
    </select>
  </f:entry>
  <f:entry title="Shared Provider ID" field="providerId"
           description="Leave empty to use the Inline choices below.">
    <f:textbox name="parameter.providerId" value="${instance.providerId}" />
  </f:entry>
  <f:entry title="Depends on" field="dependsOnText"
           description="Comma- or line-separated parameter names. Reactive dependencies require a shared Provider.">
    <f:textarea name="parameter.dependsOnText" value="${instance.dependsOnText}" />
  </f:entry>
  <f:entry title="Choices" field="choices">
    <div class="up-option-editor">
      <f:repeatableProperty field="choices" add="Add option" header="Option" />
    </div>
  </f:entry>
  <f:entry title="Import YAML or JSON" field="importSource">
    <div class="up-import-panel" data-up-import-panel="true"
         data-parameter-kind="${instance.multiple ? 'multiple' : 'single'}"
         data-endpoint="${rootURL}/descriptorByName/io.jenkins.plugins.parameterfoundry.definition.FoundryChoiceParameterDefinition/previewImport">
      <f:textarea class="up-import-source" />
      <div class="up-import-actions">
        <button type="button" class="jenkins-button" data-up-import-preview-button="true">Preview import</button>
        <button type="button" class="jenkins-button" data-up-import-apply-button="true" disabled="disabled">Apply import</button>
      </div>
      <div class="up-import-preview">
        <p class="up-import-status" data-up-import-status="true" role="status" aria-live="polite">
          Paste YAML or JSON, then preview it before changing the option editor.
        </p>
        <div data-up-import-rows="true"></div>
        <pre class="up-import-generated" data-up-import-generated="true"></pre>
      </div>
    </div>
  </f:entry>
  <j:choose>
    <j:when test="${instance.multiple}">
      <f:entry title="Renderer" field="renderer">
        <select class="jenkins-select__input" name="parameter.renderer">
          <option value="checkbox" selected="${instance.renderer == 'checkbox' ? 'selected' : null}">Checkbox group</option>
          <option value="list" selected="${instance.renderer == 'list' ? 'selected' : null}">Multi-select list</option>
          <option value="table" selected="${instance.renderer == 'table' ? 'selected' : null}">Choice table</option>
          <j:forEach var="rendererId" items="${instance.availableExternalRenderers}">
            <option value="${rendererId}" selected="${instance.renderer == rendererId ? 'selected' : null}">${rendererId}</option>
          </j:forEach>
        </select>
      </f:entry>
      <f:entry title="Selected value display" field="selectedDisplay">
        <select class="jenkins-select__input" name="parameter.selectedDisplay">
          <option value="none" selected="${instance.selectedDisplay == 'none' ? 'selected' : null}">Hidden</option>
          <option value="chips" selected="${instance.selectedDisplay == 'chips' ? 'selected' : null}">Chips</option>
        </select>
      </f:entry>
      <f:entry title="Default mode" field="defaultMode">
        <select class="jenkins-select__input" name="parameter.defaultMode">
          <option value="none" selected="${instance.defaultMode == 'none' ? 'selected' : null}">None</option>
          <option value="first" selected="${instance.defaultMode == 'first' ? 'selected' : null}">First enabled option</option>
          <option value="explicit" selected="${instance.defaultMode == 'explicit' ? 'selected' : null}">Explicit values</option>
        </select>
      </f:entry>
      <f:entry title="Default values" field="defaultValuesText">
        <f:textarea name="parameter.defaultValuesText" value="${instance.defaultValuesText}" />
      </f:entry>
      <f:entry title="Minimum selections" field="minSelections">
        <f:number name="parameter.minSelections" value="${instance.minSelections}" min="0" />
      </f:entry>
      <f:entry title="Maximum selections" field="maxSelections">
        <f:number name="parameter.maxSelections" value="${instance.maxSelections}" min="-1" />
      </f:entry>
      <f:entry title="Required" field="required">
        <f:checkbox name="parameter.required" checked="${instance.required}" />
      </f:entry>
      <f:entry title="Standard API input mode" field="standardApiInputMode">
        <select class="jenkins-select__input" name="parameter.standardApiInputMode">
          <option value="repeated" selected="${instance.standardApiInputMode == 'repeated' ? 'selected' : null}">Repeated fields</option>
          <option value="json-array" selected="${instance.standardApiInputMode == 'json-array' ? 'selected' : null}">JSON array field</option>
          <option value="delimited" selected="${instance.standardApiInputMode == 'delimited' ? 'selected' : null}">Delimited field</option>
          <option value="extended-choice" selected="${instance.standardApiInputMode == 'extended-choice' ? 'selected' : null}">Extended Choice compatibility</option>
        </select>
      </f:entry>
      <f:entry title="Delimiter" field="delimiter">
        <f:textbox name="parameter.delimiter" value="${instance.delimiter}" />
      </f:entry>
      <f:entry title="Environment export order" field="environmentExportOrder">
        <select class="jenkins-select__input" name="parameter.environmentExportOrder">
          <option value="canonical" selected="${instance.environmentExportOrder == 'canonical' ? 'selected' : null}">Canonical (sorted) order</option>
          <option value="submitted" selected="${instance.environmentExportOrder == 'submitted' ? 'selected' : null}">Submitted order</option>
        </select>
      </f:entry>
      <f:entry title="Duplicate policy" field="duplicatePolicy">
        <select class="jenkins-select__input" name="parameter.duplicatePolicy">
          <option value="reject" selected="${instance.duplicatePolicy == 'reject' ? 'selected' : null}">Reject duplicates</option>
          <option value="deduplicate" selected="${instance.duplicatePolicy == 'deduplicate' ? 'selected' : null}">Deduplicate canonical values</option>
        </select>
      </f:entry>
    </j:when>
    <j:otherwise>
      <f:entry title="Renderer" field="renderer">
        <select class="jenkins-select__input" name="parameter.renderer">
          <option value="select" selected="${instance.renderer == 'select' ? 'selected' : null}">Select</option>
          <option value="searchable" selected="${instance.renderer == 'searchable' ? 'selected' : null}">Searchable</option>
          <option value="radio" selected="${instance.renderer == 'radio' ? 'selected' : null}">Radio</option>
          <option value="list" selected="${instance.renderer == 'list' ? 'selected' : null}">List box</option>
          <j:forEach var="rendererId" items="${instance.availableExternalRenderers}">
            <option value="${rendererId}" selected="${instance.renderer == rendererId ? 'selected' : null}">${rendererId}</option>
          </j:forEach>
        </select>
      </f:entry>
      <f:entry title="Default mode" field="defaultMode">
        <select class="jenkins-select__input" name="parameter.defaultMode">
          <option value="none" selected="${instance.defaultMode == 'none' ? 'selected' : null}">None</option>
          <option value="first" selected="${instance.defaultMode == 'first' ? 'selected' : null}">First enabled option</option>
          <option value="explicit" selected="${instance.defaultMode == 'explicit' ? 'selected' : null}">Explicit value</option>
        </select>
      </f:entry>
      <f:entry title="Default value" field="defaultValue">
        <f:textbox name="parameter.defaultValue" value="${instance.defaultValue}" />
      </f:entry>
      <f:entry title="Required" field="required">
        <f:checkbox name="parameter.required" checked="${instance.required}" />
      </f:entry>
      <f:entry title="Allow custom value" field="allowCustomValue">
        <f:checkbox name="parameter.allowCustomValue" checked="${instance.allowCustomValue}" />
      </f:entry>
      <f:entry title="Custom value regex" field="customValuePattern">
        <f:textbox name="parameter.customValuePattern" value="${instance.customValuePattern}" />
      </f:entry>
      <f:entry title="Custom value maximum length" field="customValueMaxLength">
        <f:number name="parameter.customValueMaxLength"
                  value="${instance.customValueMaxLength}" min="1" max="4096" />
      </f:entry>
    </j:otherwise>
  </j:choose>
  <f:entry title="Description" help="/help/parameter/description.html">
    <f:textarea name="parameter.description" value="${instance.description}" />
  </f:entry>
  </div>
</j:jelly>
